# Keep shell scripts LF-only so the Linux shebang survives a Windows checkout.
# Without this, Git for Windows (core.autocrlf=true by default) rewrites LF->CRLF
# on checkout, and the container fails to start with:
#   exec .../entrypoint.sh: No such file or directory
# (the kernel can't find interpreter "/bin/bash\r").
*.sh text eol=lf
entrypoint.sh text eol=lf
